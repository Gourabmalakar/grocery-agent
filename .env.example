# Nothing here is a real secret. Copy to .env and fill in for your machine.

# Mode gate. The broker refuses to touch real money unless this is exactly
# "live", and even then only after the Phase-4 checklist has been run once.
# Every other value (including unset) behaves as dry_run.
MODE=dry_run

# Console session signing (itsdangerous). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Losing this just invalidates open sessions — it is not the credential vault.
SESSION_SECRET_KEY=

# Where mandate signing keys and the encrypted credential vault live. Kept
# outside git entirely (see .gitignore) — there is nothing to commit here.
DATA_DIR=./data

# The mock storefront the worker talks to in Phase 0-1. Point this at real
# adapters only from Phase 2 onward.
MOCKSTORE_URL=http://127.0.0.1:8801

# Anthropic key for the worker's reasoning calls. Absent = the worker falls
# back to a deterministic (cheapest-unit-price) picker so the whole loop is
# runnable and testable with zero external calls.
ANTHROPIC_API_KEY=

# Per-order / per-day / per-month hard caps in INR (paise as ints internally).
# These are enforced in grocery/ledger/budget.py, not by the model.
CAP_PER_ORDER_INR=800
CAP_PER_DAY_INR=1500
CAP_PER_MONTH_INR=6000

# Phase 2 real-site browser adapters (grocery/adapters/*_browser.py) read
# prices for a delivery location, not an account — a real public coordinate,
# not a credential. Default is Connaught Place, New Delhi; override for a
# different area.
ADAPTER_LOCATION_LAT=28.6304
ADAPTER_LOCATION_LON=77.2177
ADAPTER_LOCATION_LABEL=Connaught Place, New Delhi, Delhi 110001, India
