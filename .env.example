# Nothing here is a real secret. Copy to .env and fill in for your machine.

# Mode gate. The broker refuses to touch real money unless this is exactly
# "live", and even then only after the Phase-4 checklist has been run once.
# Every other value (including unset) behaves as dry_run.
MODE=dry_run

# Console session signing (itsdangerous). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Losing this just invalidates open sessions — it is not the credential vault.
SESSION_SECRET_KEY=

# Where mandate signing keys and the encrypted credential vault live. Kept
# outside git entirely (see .gitignore) — there is nothing to commit here.
DATA_DIR=./data

# The mock storefront the worker talks to in Phase 0-1. Point this at real
# adapters only from Phase 2 onward.
MOCKSTORE_URL=http://127.0.0.1:8801

# Anthropic key for the worker's reasoning calls. Absent = the worker falls
# back to a deterministic (cheapest-unit-price) picker so the whole loop is
# runnable and testable with zero external calls.
ANTHROPIC_API_KEY=

# Per-order / per-day / per-month hard caps in INR (paise as ints internally).
# These are enforced in grocery/ledger/budget.py, not by the model.
CAP_PER_ORDER_INR=800
CAP_PER_DAY_INR=1500
CAP_PER_MONTH_INR=6000

# FIRST-RUN DEFAULTS FOR THE DELIVERY ADDRESS ONLY.
#
# The address actually in force lives in data/location.json and is edited from
# the Console's Control page — these values only seed it on a fresh checkout.
# Don't change these expecting the running app to follow; change it in the UI.
#
# It matters more than it looks: the address decides which shelves are visible.
# The same "amul milk" search returns twelve Amul products at 560001 and, at an
# unserviceable pincode, a page of nationally-shipped marketplace goods that is
# NOT an error and NOT comparable with 10-minute delivery.
#
# PRIVACY, because this is the block people fill in without thinking. There is
# NOWHERE HERE for a flat number, a building, or a phone number, on purpose —
# nothing in this system needs them until the payment stage, and data it does not
# hold cannot leak into a prompt, a log, or a merchant request. The coordinate is
# ROUNDED TO ~1.1 KM before it is stored, so what lands on disk points at an area
# rather than a building (verified: the rounded point returns identical Blinkit
# prices). The label is a nickname for a human reading the Control page; it never
# leaves the machine and is never given to an adapter.
#
# Pincode: JioMart (and Zepto) locate you by it.
ADAPTER_LOCATION_PINCODE=560001
# Coordinates: Blinkit locates you by these. Without them Blinkit is left out
# of the comparison and says so, rather than shopping a guessed-at address.
ADAPTER_LOCATION_LAT=12.9767
ADAPTER_LOCATION_LON=77.5993
# A NICKNAME, not an address. Never sent to a merchant, never read by the worker.
ADAPTER_LOCATION_LABEL=Home

# Which merchants the worker searches. "mock" (the default in grocery/config.py,
# and what the whole test suite runs on) uses mockstore's three fake merchants
# over localhost. "real" uses JioMart + Blinkit + Swiggy Instamart + Zepto, each
# skipped with a stated reason if it cannot be reached.
# tests/adapters/test_default_backend_is_offline.py guarantees this line cannot
# leak into pytest and launch a browser mid-suite.
MERCHANT_BACKEND=mock

# Optional. Which saved address to shop from at a merchant that forces us to
# pick one. Empty means: use the only address there is, and refuse to choose
# between several rather than silently pricing a neighbourhood nobody chose.
# Swiggy's search_products REQUIRES an addressId (its lat/lon "guest mode" is
# refused for an authenticated token); Zepto's gate needs one too.
SWIGGY_ADDRESS_ID=
ZEPTO_ADDRESS_ID=

# ---------------------------------------------------------------- payments --
# off      build the basket and stop. No payment of any kind. (default)
# handoff  build the basket; Gourab pays in the merchant's own app. Nothing in
#          this system can charge anything.
# wallet   handoff PLUS letting the agent pay from the Swiggy Money float.
#          The money in that wallet is the entire blast radius. Never auto-top-up.
PAYMENT_BACKEND=off

# Authorises ONE payment, typed into Telegram. Separate from SESSION_SECRET_KEY
# so a Telegram compromise does not also open the Console, and so it rotates
# alone. Required before PAYMENT_BACKEND can leave "off".
BOT_PASSPHRASE=

# How long a chat approval is good for, and how many wrong tries before the
# system pauses itself.
PASSPHRASE_TTL_SECONDS=300
PASSPHRASE_MAX_ATTEMPTS=3
